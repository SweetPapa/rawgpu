{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rawgpu",
  "version": "0.1.0",
  "identifier": "dev.rawgpu.tray",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "rawgpu",
        "width": 348,
        "height": 540,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visibleOnAllWorkspaces": true,
        "center": true,
        "url": "panel.html",
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 12
        }
      },
      {
        "label": "details",
        "title": "rawgpu: RX 590",
        "width": 620,
        "height": 700,
        "minWidth": 460,
        "minHeight": 420,
        "visible": false,
        "resizable": true,
        "url": "index.html",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "RX 590 status and eject",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "externalBin": [
      "binaries/rawgpu"
    ],
    "resources": {
      "../../tools/fetch-firmware.sh": "scripts/fetch-firmware.sh",
      "../../tools/install-tinygpu.sh": "scripts/install-tinygpu.sh",
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "binaries/THIRD_PARTY_RUST.md": "THIRD_PARTY_RUST.md"
    },
    "copyright": "\u00a9 2026 Forrester Terry. MIT license."
  }
}
